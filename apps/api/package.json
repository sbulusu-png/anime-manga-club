{
  "name": "@amc/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:prod": "node --env-file-if-exists=../../.env dist/scripts/migrate.js",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:studio": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs studio",
    "user:set-role": "tsx --env-file-if-exists=../../.env src/scripts/set-role.ts",
    "db:smoke": "tsx --env-file-if-exists=../../.env src/scripts/db-smoke.ts",
    "titles:refresh": "tsx --env-file-if-exists=../../.env src/scripts/refresh-titles.ts",
    "db:check-drift": "drizzle-kit generate --name drift_check && tsx src/scripts/check-drift.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@scalar/hono-api-reference": "0.12.4",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "hono-openapi": "1.3.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
