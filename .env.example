# Copy to .env and fill in. Get both database URLs from Neon > Connect
# (toggle "Connection pooling" on for DATABASE_URL, off for DATABASE_URL_UNPOOLED).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Optional: comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (defaults to private ranges).
# TRUSTED_PROXIES=""
# Email (sign-in codes, verification, password reset). Without a key, emails are printed to
# the API log (in development they're always printed too, so you can read sign-in codes there).
# Required in production: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Anime Manga Club <onboarding@resend.dev>"
# REQUIRE_EMAIL_VERIFICATION="true"
# Only these email domains (and their subdomains) can join. Required in production.
# Outside production, example.com also works (for test accounts).
ALLOWED_EMAIL_DOMAINS="uni.edu,uni.ac.in"
# Club weeks start on Monday in this timezone.
# CLUB_TIMEZONE="Asia/Kolkata"

# The API listens here; the website (port 3000) proxies /api to it.
API_PORT="4000"
